                        },
                    
                        'zh-hans':
                        {
                            'name': '简体中文',
                            'url': '/zh-hans/download/',
                            'message': '此页面也有 简体中文 (zh-hans) 版本',
                        },
                    
                        'zh-hant':
                        {
