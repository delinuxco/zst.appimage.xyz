                        },
                    
                };

                function resolvePreferredLanguage(language_code) {
                    if (!language_code) {
                        return null;
                    }
                    var normalized = language_code.toLowerCase().replace(/_/g, '-');
                    if (normalized in languages) {
                        return normalized;
                    }
                    if (normalized.indexOf('zh-') === 0) {
                        if (normalized === 'zh-cn' || normalized === 'zh-sg' || normalized === 'zh-hans') {
                            if ('zh-hans' in languages) {
                                return 'zh-hans';
                            }
                        } else if (normalized === 'zh-tw' || normalized === 'zh-hk' || normalized === 'zh-mo' || normalized === 'zh-hant') {
                            if ('zh-hant' in languages) {
                                return 'zh-hant';
                            }
                        }
                    }
                    var base = normalized.split('-')[0];
                    if (base in languages) {
                        return base;
                    }
                    return null;
                }

                function updateLanguageAlert(force_lang, force_show) {
                    var preferred_code = force_lang || (navigator.language || navigator.userLanguage);
                    var selected_lang = resolvePreferredLanguage(preferred_code);
                    if (selected_lang && (force_show || current_lang != selected_lang)) {
                        var preferred_message = languages[selected_lang]["message"];
                        var is_fallback_english = false;
                        if (selected_lang !== "en") {
                            is_fallback_english = preferred_message.indexOf("This page is also available in ") === 0;
                        }
                        if (!is_fallback_english) {
                            $("#preferred-language-link").text(preferred_message);
                            $("#preferred-language-link").attr("href", languages[selected_lang]["url"]);
                            $("#preferred-language-cta").show();
                            $("#language-icon-header").addClass("language-icon-attention");
                            return;
                        }
                    }
                    $("#preferred-language-cta").hide();
                    $("#language-icon-header").removeClass("language-icon-attention");
                }

                // Show language alert (if preferred language different)
                updateLanguageAlert(preferred_lang);
                window.updateLanguageAlert = updateLanguageAlert;

                

    function get_bits_system_architecture()
    {
        var _to_check = [] ;
        if ( window.navigator.cpuClass ) _to_check.push( ( window.navigator.cpuClass + "" ).toLowerCase() ) ;
        if ( window.navigator.platform ) _to_check.push( ( window.navigator.platform + "" ).toLowerCase() ) ;
        if ( navigator.userAgent ) _to_check.push( ( navigator.userAgent + "" ).toLowerCase() ) ;

        var _64bits_signatures = [ "x86_64", "x86-64", "Win64", "x64;", "amd64", "AMD64", "WOW64", "x64_64", "ia64", "sparc64", "ppc64", "IRIX64" ] ;
        var _bits = 32, _i, _c ;
        outer_loop:
        for( var _c = 0 ; _c < _to_check.length ; _c++ )
        {
            for( _i = 0 ; _i < _64bits_signatures.length ; _i++ )
            {
                if ( _to_check[_c].indexOf( _64bits_signatures[_i].toLowerCase() ) != -1 )
                {
                   _bits = 64 ;
                   break outer_loop;
                }
            }
        }
        return _bits ;
    }

    // Detect browser OS type (if possible)
    var isLinux = navigator.platform.toUpperCase().indexOf('LINUX')!==-1;
    var isMac = navigator.platform.toUpperCase().indexOf('MAC')!==-1;
    var isWindows = navigator.platform.toUpperCase().indexOf('WIN')!==-1;
    var isChromeOS = navigator.userAgent.toUpperCase().indexOf('CROS')!==-1;
    var isChromeX86 = navigator.userAgent.toUpperCase().indexOf('X86_64')!==-1;
    var bits = get_bits_system_architecture();

    function showDownloadPlatform(platform, animate) {
        var $target = $('.os-' + platform);
        $('.download-platform-panel').removeClass('is-active').prop('hidden', true).hide();
        $target.addClass('is-active').prop('hidden', false).css('display', '');
        if (animate) {
            $target.stop(true, true).css({opacity: 0}).animate({opacity: 1}, 200);
        } else {
            $target.css({opacity: 1});
        }
        $('[data-platform]').removeClass('active').attr({'aria-selected': 'false', tabindex: '-1'});
        $('[data-platform="' + platform + '"]').addClass('active').attr({'aria-selected': 'true', tabindex: '0'});
    }

    function setWindowsArchitecture(architecture) {
        var selectedArchitecture = architecture === '32' ? '32' : '64';
        var $card = $('[data-windows-exe-card]');

        $('[data-windows-architecture]').each(function() {
            var isSelected = $(this).data('windows-architecture').toString() === selectedArchitecture;
            $(this).toggleClass('active', isSelected).attr('aria-pressed', isSelected);
        });
        $('[data-windows-architecture-copy]').each(function() {
            $(this).prop('hidden', $(this).data('windows-architecture-copy').toString() !== selectedArchitecture);
        });
        $card.find('[data-windows-download-link]').attr('href', $card.find('[data-windows-download-link]').attr('data-url-' + selectedArchitecture));
        $card.find('[data-windows-torrent-link]').attr('href', $card.find('[data-windows-torrent-link]').attr('data-url-' + selectedArchitecture));
        $card.find('[data-windows-verify-link]').attr('href', $card.find('[data-windows-verify-link]').attr('data-url-' + selectedArchitecture));
    }

    $('[data-windows-architecture]').click(function() {
        setWindowsArchitecture($(this).data('windows-architecture').toString());
    });

    setWindowsArchitecture(bits == 32 ? '32' : '64');

    // Show the correct OS version (or default to Linux)
    if (isWindows) {
        showDownloadPlatform('windows', false);
    }
    else if (isMac) {
        showDownloadPlatform('mac', false);
    }
    else if (isChromeOS) {
        showDownloadPlatform('chromeos', false);
    }
    else {
        showDownloadPlatform('linux', false);
    }

    $('[data-platform]').click(function() {
        showDownloadPlatform($(this).data('platform'), true);
    });

    $('[data-platform]').keydown(function(event) {
        var $tabs = $('[data-platform]');
        var currentIndex = $tabs.index(this);
        var nextIndex = currentIndex;

        if (event.key === 'ArrowRight') nextIndex = (currentIndex + 1) % $tabs.length;
        else if (event.key === 'ArrowLeft') nextIndex = (currentIndex - 1 + $tabs.length) % $tabs.length;
        else if (event.key === 'Home') nextIndex = 0;
        else if (event.key === 'End') nextIndex = $tabs.length - 1;
        else return;

        event.preventDefault();
        $tabs.eq(nextIndex).focus().click();
    });

    $('[data-copy-target]').click(function() {
        var $button = $(this);
        var command = document.getElementById($button.data('copy-target')).textContent;

        navigator.clipboard.writeText(command).then(function() {
            $button.addClass('copied').attr({'title': 'Copied', 'aria-label': 'Copied'});
            setTimeout(function() {
                $button.removeClass('copied').attr({'title': 'Copy install command', 'aria-label': 'Copy install command'});
            }, 1600);
        });
    });

    // Show the non x86 chrome message (if needed)
    if (isChromeX86) {
        $('.chromeos-x86').show();
        $('.chromeos-non-x86').hide();
    } else {
        $('.chromeos-x86').hide();
        $('.chromeos-non-x86').show();
    }

    // Daily build tables are secondary details and span the full platform panel.
    $('.os-linux table.daily-build-container, .os-mac table.daily-build-container, .os-windows table.daily-build-container').each(function() {
        var $platformPanel = $(this).closest('.download-platform-panel');
        $(this).addClass('daily-build-full-width').appendTo($platformPanel);
    });

    var dailyBuildsVisible = window.location.hash.substring(1) === "daily";

    function setDailyBuildsVisible(visible, animate) {
        dailyBuildsVisible = visible;
        var $chromeDaily = $('.chromeos-daily-row');
        var $chromeStable = $('.chromeos-stable-row');
        var $dailyBuilds = $('.daily-build-container').not($chromeDaily);
        if (animate) {
            $dailyBuilds.stop(true, true)[visible ? 'slideDown' : 'slideUp'](200);
            if (visible) {
                $chromeStable.stop(true, true).fadeOut(100, function() {
                    $chromeDaily.stop(true, true).fadeIn(150);
                });
            } else {
                $chromeDaily.stop(true, true).fadeOut(100, function() {
                    $chromeStable.stop(true, true).fadeIn(150);
                });
            }
        } else {
            $dailyBuilds.toggle(visible);
            $chromeDaily.toggle(visible);
            $chromeStable.toggle(!visible);
        }
        $('#daily-builds').toggleClass('active', visible).attr('aria-expanded', visible);
    }

    setDailyBuildsVisible(dailyBuildsVisible, false);

    $('#daily-builds').click(function(event) {
        event.preventDefault();
        setDailyBuildsVisible(!dailyBuildsVisible, true);
    });

    $('.openshot-download-support').hide();
    var downloadConfirmAdShown = false;

    $('.download-openshot').click(function() {
        var $downloadSupport = $('.openshot-downloaded');
        $downloadSupport.stop(true, true).fadeIn(250, function() {
            var headerHeight = $('#header').outerHeight() || 0;
            var supportTop = $downloadSupport.offset().top - headerHeight - 20;
            window.scrollTo({
                top: Math.max(0, supportTop),
                behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
            });
        });
        if (!downloadConfirmAdShown && typeof googletag !== 'undefined') {
            googletag.cmd.push(function() {
                googletag.display('div-gpt-ad-1555132001824-0');
            });
            downloadConfirmAdShown = true;
        }
    });



                // Switch language
                $('#language-form').submit(function(event) {
                    event.preventDefault();

                    var language_code = $("#language-dropdown").val();
                    if (language_code == "en")
                        window.location = "/download/";
                    else
                        window.location = "/" + language_code + "/download/";
                });

                // View translators
                $('#translator-credits').click(function(event) {
                    event.preventDefault();

                    // Show all download containers
                    $('#translators-body').fadeIn();
                });
            });

            
        </script>

