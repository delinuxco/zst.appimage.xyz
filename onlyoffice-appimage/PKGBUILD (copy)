_pkgname=DesktopEditors
pkgname=onlyoffice-desktopeditors-appimage
pkgver=9.4.0
pkgrel=1
pkgdesc="Open SOurce office suite that combines documents, spreadsheet, presentation and more."
arch=('x86_64')
url=https://www.onlyoffice.com/
license=('GNU AGPL v3')
provides=('DesktopEditors')
conflicts=('onlyoffice-bin' 'onlyoffice')
depends=(
    'fuse-common'
    'fuse2'
    'fuse3'
)
#optdepends=(
#    'libappindicator-gtk3: tray icon'
#    'libayatana-appindicator: tray icon'
#)
options=(!strip)
source_x86_64=(https://github.com/ONLYOFFICE/appimage-desktopeditors/releases/download/v${pkgver}/${_pkgname}-${arch}.AppImage)
#               https://github.com/ONLYOFFICE/appimage-desktopeditors/releases/download/v9.4.0/DesktopEditors-x86_64.AppImage
sha256sums_x86_64=('f5faf24552665262fe94486a510b997d2e5a24bde14df94c802c79bf17f9254c')
_filename=${_pkgname}-${arch}.AppImage

prepare() {
  cd "${srcdir}"
  chmod +x ${_filename}
  ./${_filename} --appimage-extract

        mkdir -p "${srcdir}/squashfs-root/assets/icons/"
        mkdir -p "${srcdir}/squashfs-root/assets/launchers/"

        cp /home/delinuxco/DLC_Builds/appimages/onlyoffice-appimage/local_assets/onlyoffice-desktopeditors.svg "${srcdir}/squashfs-root/assets/icons/onlyoffice-desktopeditors.svg"
        cp "${srcdir}/squashfs-root/onlyoffice-desktopeditors.desktop" "${srcdir}/squashfs-root/assets/launchers/onlyoffice-desktopeditors.desktop"

        sed -i -E 's|Exec=desktopeditors %F|Exec=/opt/appimages/onlyoffice-desktopeditors.AppImage %F|g' "${srcdir}/squashfs-root/assets/launchers/onlyoffice-desktopeditors.desktop"
}

package() {
  install -Dm755 "${srcdir}/${_filename}" "${pkgdir}/opt/appimages/onlyoffice-desktopeditors.AppImage"

  install -Dm644 "${srcdir}/squashfs-root/assets/icons/onlyoffice-desktopeditors.svg" "${pkgdir}/usr/share/icons/hicolor/scalable/apps/onlyoffice-desktopeditors.svg"

  install -Dm644 "${srcdir}/squashfs-root/assets/launchers/onlyoffice-desktopeditors.desktop" "${pkgdir}/usr/share/applications/onlyoffice-desktopeditors.desktop"

  install -d "$pkgdir/usr/bin"

  ln -s /opt/appimages/onlyoffice-desktopeditors.AppImage "${pkgdir}/usr/bin/desktopeditors"

}
