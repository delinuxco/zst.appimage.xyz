pkgname=artcraft-suite
pkgver="1.3"
pkgrel=1
pkgdesc="A simple meta-package to install ArtCraft apps"
arch=('x86_64')
url="https://delinux.co"
license=('GPL-V3')
depends=(
    'effectcraft-appimage'
    'filmcraft-appimage'
    'lightcraft-appimage'
    'pdfcraft-appimage'
    'photocraft-appimage'
    'soundcraft-appimage'
    'vectorcraft-appimage'
    'wordcraft-appimage'
    'gridcraft-appimage'
    'deckcraft-appimage'
    'cadcraft-appimage'
    'designcraft-appimage'
    'figcraft-appimage'
)
source=()
makedepends=()

# A meta-package does not need a build or package function 
# because it contains no files of its own. 
# However, we define an empty package function to satisfy makepkg.

package() {
  # No files to install in a meta-package
  return 0
}

